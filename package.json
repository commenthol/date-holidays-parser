{
  "name": "date-holidays-parser",
  "version": "3.6.0",
  "description": "parser for worldwide holidays",
  "keywords": [
    "holidays",
    "parser",
    "world"
  ],
  "homepage": "https://github.com/commenthol/date-holidays-parser",
  "bugs": {
    "url": "https://github.com/commenthol/date-holidays-parser/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/commenthol/date-holidays-parser.git"
  },
  "license": "ISC",
  "author": "commenthol <commenthol@gmail.com>",
  "maintainers": [
    "commenthol <commenthol@gmail.com>"
  ],
  "contributors": [
    "Christian Schinnerl <Schinnerl.Christian@gmail.com>",
    "Lukas Eipert <git@leipert.io>",
    "davidan90 <david16an@gmail.com>",
    "0xflotus <0xflotus@gmail.com>",
    "Stefan <stefan@devliert.info>",
    "Leonidas Villeneuve <leonidas@leonidasv.com>",
    "mohammadyaser <m.y.ahmadi22@gmail.com>",
    "oprogramador <uomodislesia@gmail.com>",
    "pzien <paulina.zientarska@areo.io>",
    "Daniel Belfiore <belfiore@gmx.net>",
    "Yoshio HANAWA <y@hnw.jp>"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js",
      "require": "./lib/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./lib/index.cjs",
  "module": "./src/index.js",
  "types": "./types/index.d.ts",
  "directories": {
    "lib": "lib",
    "doc": "docs",
    "test": "test"
  },
  "files": [
    "lib",
    "src",
    "types",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "all": "run-s clean pretty lint build postbuild test types",
    "build": "rollup -c",
    "postbuild": "node scripts/postbuild.cjs",
    "ci": "run-s all",
    "clean": "rimraf lib es coverage .nyc_output",
    "clean:all": "run-s clean clean:node_modules",
    "clean:node_modules": "rimraf node_modules",
    "coverage": "c8 -r text -r html npm test",
    "lint": "eslint src test",
    "pretty": "prettier -w src test",
    "prepublishOnly": "npm run all",
    "test": "run-s test:*",
    "test:ci": "mocha",
    "test:tz": "TZ=UTC-10 mocha && TZ=UTC+10 mocha",
    "types": "tsc -p ./tsconfig.json"
  },
  "mocha": {
    "checkLeaks": true,
    "colors": true
  },
  "dependencies": {
    "@hnw/date-tibetan": "^1.0.2",
    "astronomia": "^4.2.0",
    "caldate": "^2.0.5",
    "date-bengali-revised": "^2.0.2",
    "date-chinese": "^2.1.4",
    "date-easter": "^1.0.3",
    "deepmerge": "^4.3.1",
    "jalaali-js": "^2.0.1",
    "moment-timezone": "^0.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "c8": "^12.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "hashtree": "^0.7.0",
    "mocha": "^12.0.3",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.4",
    "rollup": "^4.67.5",
    "serialize-to-module": "^1.1.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=12.0.0"
  }
}
